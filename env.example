# Anthropic API (obrigatório)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot (obrigatório para receber alertas)
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=123456789,987654321

# Webhook authentication (opcional mas recomendado)
WEBHOOK_SECRET=uma-string-secreta-aqui

# Porta do servidor (Railway define automaticamente)
PORT=3000

# [v3] Enviar notificação Telegram quando signal é NO_TRADE (para debug)
NOTIFY_NO_TRADE=false

# [v3] Caminho do ficheiro de journal (cada signal é gravado aqui)
JOURNAL_PATH=./trade_journal.jsonl

# [v4] Supabase — persistent journal storage (replaces ephemeral JSONL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [v4] Apex Risk Guard — daily limits (resets at midnight ET)
APEX_MAX_DAILY_SIGNALS=10
APEX_DAILY_LOSS_LIMIT=150

# [v4] News Event Filter — suppress signals near high-impact economic events
NEWS_FILTER_ENABLED=true
NEWS_SUPPRESS_WINDOW_MIN=15
NEWS_SUPPRESS_MODE=block
