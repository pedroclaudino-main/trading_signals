//@version=6

// ─────────────────────────────────────────────────────────────────────────────
// Trading_Signals — Backtest
// Lógica idêntica ao indicador mnq_ict_scalper.pine (todos os 11 fixes aplicados)
// Usa strategy() para aceder ao Strategy Tester do TradingView
//
// INSTRUÇÕES:
//   1. Aplica ao gráfico MNQH2026 em timeframe de 1 minuto
//   2. Abre o painel "Strategy Tester" (separador na base do gráfico)
//   3. Ajusta Capital Inicial, Contratos e Comissão nos Inputs
//   4. Consulta: Net Profit, Win Rate, Profit Factor, Max Drawdown
// ─────────────────────────────────────────────────────────────────────────────

strategy(
 title                  = "Trading_Signals — Backtest",
 overlay                = true,
 max_bars_back          = 500,
 initial_capital        = 10000,
 default_qty_type       = strategy.fixed,
 default_qty_value      = 1,
 commission_type        = strategy.commission.cash_per_contract,
 commission_value       = 0.62,   // $ por contrato por lado (ajustável nos Inputs)
 slippage               = 1,      // ticks de slippage (1 tick = 0.25 pts)
 calc_on_every_tick     = false,  // calcula apenas em barras confirmadas (sem warnings)
 pyramiding             = 0)      // sem entradas adicionais enquanto trade aberta

// ── Inputs — Estratégia ────────────────────────────────────────────────────
swingLookback = input.int(5,     "Swing Lookback (bars)",           minval=2, maxval=20,  group="Estratégia")
obStrength    = input.float(1.5, "OB Break Strength (multiplier)",  minval=1.0, maxval=3.0, group="Estratégia")
maxRiskPts    = input.float(60.0,"Max Risk (pontos)",               minval=10.0,             group="Estratégia")

// ── Inputs — Backtest ──────────────────────────────────────────────────────
i_contracts   = input.int(1,     "Contratos por trade",             minval=1, maxval=10,   group="Backtest")
i_commission  = input.float(0.62,"Comissão por contrato/lado ($)",  minval=0.0, step=0.01, group="Backtest")
i_showLabels  = input.bool(true, "Mostrar labels de Entry/TP/SL",                          group="Backtest")

// ── Session windows (Europe/Lisbon) ────────────────────────────────────────
inSession1 = not na(time(timeframe.period, "1445-1515:1234567", "Europe/Lisbon"))
inSession2 = not na(time(timeframe.period, "1545-1615:1234567", "Europe/Lisbon"))
inSession3 = not na(time(timeframe.period, "1645-1715:1234567", "Europe/Lisbon"))
inSession  = inSession1 or inSession2 or inSession3
sessionLabel = inSession1 ? "14:45" : inSession2 ? "15:45" : inSession3 ? "16:45" : "N/A"

bgcolor(inSession ? color.new(color.blue, 92) : na, title="Session Window")

// ── Tick rounding (MNQ = 0.25 pts) ─────────────────────────────────────────
roundTick(x) => math.round(x * 4) / 4

// ── Order Block Detection ──────────────────────────────────────────────────
isBullishOB(i) => close[i] < open[i] and close[i-1] > open[i-1] and (close[i-1] - open[i-1]) > (high[i] - low[i]) * obStrength
isBearishOB(i) => close[i] > open[i] and close[i-1] < open[i-1] and (open[i-1] - close[i-1]) > (high[i] - low[i]) * obStrength

var float  bullOB_high   = na
var float  bullOB_low    = na
var float  bearOB_high   = na
var float  bearOB_low    = na
var bool   bullOB_broken = false
var bool   bearOB_broken = false
var string bias          = "NONE"

if isBullishOB(1)
    bullOB_high   := high[1]
    bullOB_low    := low[1]
    bullOB_broken := false

if isBearishOB(1)
    bearOB_high   := high[1]
    bearOB_low    := low[1]
    bearOB_broken := false

bullBreakNow = not bullOB_broken and not na(bullOB_high) and close > bullOB_high
bearBreakNow = not bearOB_broken and not na(bearOB_low)  and close < bearOB_low

if bullBreakNow
    bullOB_broken := true
    bias          := "BULLISH"

if bearBreakNow
    bearOB_broken := true
    bias          := "BEARISH"

// FIX: Bias reseta no FIM de cada sessão (não no início)
// Reset no início causava race condition: OB break na 1ª barra era imediatamente apagado
sessionEnded = not inSession and inSession[1]
if sessionEnded
    bias := "NONE"

// ── Fair Value Gap (persistido, com expiry e bearFVG corrigido) ────────────
var float bullFVG_top    = na
var float bullFVG_bottom = na
var int   bullFVG_bar    = na
var bool  bullFVG_active = false

var float bearFVG_top    = na
var float bearFVG_bottom = na
var int   bearFVG_bar    = na
var bool  bearFVG_active = false

var box lastBullBox = na
var box lastBearBox = na

newBullFVG = low[0] > high[2]
newBearFVG = high[0] < low[2]

if newBullFVG
    bullFVG_top    := low[0]
    bullFVG_bottom := high[2]
    bullFVG_bar    := bar_index
    bullFVG_active := true
    box.delete(lastBullBox)
    lastBullBox    := box.new(bar_index - 2, bullFVG_top, bar_index + 20, bullFVG_bottom,
                               border_color = color.new(color.green, 50),
                               bgcolor      = color.new(color.green, 88))

if newBearFVG
    bearFVG_top    := low[2]   // preço mais alto (limite superior)
    bearFVG_bottom := high[0]  // preço mais baixo (limite inferior)
    bearFVG_bar    := bar_index
    bearFVG_active := true
    box.delete(lastBearBox)
    lastBearBox    := box.new(bar_index - 2, bearFVG_top, bar_index + 20, bearFVG_bottom,
                               border_color = color.new(color.red, 50),
                               bgcolor      = color.new(color.red, 88))

// FVG expira após 20 barras sem toque
if bullFVG_active and (bar_index - bullFVG_bar) > 20
    bullFVG_active := false
    box.delete(lastBullBox)

if bearFVG_active and (bar_index - bearFVG_bar) > 20
    bearFVG_active := false
    box.delete(lastBearBox)

// ── Swing Points para SL ───────────────────────────────────────────────────
swingHigh = ta.pivothigh(high, swingLookback, swingLookback)
swingLow  = ta.pivotlow(low,  swingLookback, swingLookback)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow  := swingLow

plotshape(not na(swingHigh), style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   60), size=size.tiny, offset=-swingLookback)
plotshape(not na(swingLow),  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 60), size=size.tiny, offset=-swingLookback)

// ── Entry: toque no FVG em barra futura, alinhado com bias ────────────────
touchesBullFVG = bias == "BULLISH" and bullFVG_active and not newBullFVG
               and low <= bullFVG_top and low >= bullFVG_bottom

touchesBearFVG = bias == "BEARISH" and bearFVG_active and not newBearFVG
               and high >= bearFVG_bottom and high <= bearFVG_top

if touchesBullFVG
    bullFVG_active := false

if touchesBearFVG
    bearFVG_active := false

longSignal  = inSession and touchesBullFVG and not na(lastSwingLow)
shortSignal = inSession and touchesBearFVG and not na(lastSwingHigh)

// Sem sinal duplo simultâneo
if longSignal and shortSignal
    longSignal  := false
    shortSignal := false

// ── Níveis: Entry = limite do FVG, TP/SL arredondados ao tick de 0.25 ──────
longEntry = longSignal  ? roundTick(bullFVG_bottom) : na
longSL    = longSignal  ? roundTick(lastSwingLow)   : na
longTP    = longSignal  ? roundTick(bullFVG_bottom + (bullFVG_bottom - lastSwingLow) * 2.0) : na
longRisk  = longSignal  ? bullFVG_bottom - lastSwingLow : na

shortEntry = shortSignal ? roundTick(bearFVG_top)   : na
shortSL    = shortSignal ? roundTick(lastSwingHigh) : na
shortTP    = shortSignal ? roundTick(bearFVG_top - (lastSwingHigh - bearFVG_top) * 2.0) : na
shortRisk  = shortSignal ? lastSwingHigh - bearFVG_top : na

validLong  = longSignal  and not na(longRisk)  and longRisk  > 0 and longRisk  <= maxRiskPts
validShort = shortSignal and not na(shortRisk) and shortRisk > 0 and shortRisk <= maxRiskPts

// ── Execução da estratégia ─────────────────────────────────────────────────
// Os níveis de TP/SL são guardados em var para estarem disponíveis em todas as
// barras enquanto a posição está aberta — strategy.exit() DEVE ser chamado em
// cada barra, não apenas na barra de sinal, para o broker simulado funcionar.

var float activeLongTP  = na
var float activeLongSL  = na
var float activeShortTP = na
var float activeShortSL = na

if validLong
    activeLongTP := longTP
    activeLongSL := longSL
    strategy.entry("Long", strategy.long, qty=i_contracts,
                   comment="LONG | " + sessionLabel + " | OB+FVG")

if validShort
    activeShortTP := shortTP
    activeShortSL := shortSL
    strategy.entry("Short", strategy.short, qty=i_contracts,
                   comment="SHORT | " + sessionLabel + " | OB+FVG")

// Exit chamado em CADA BARRA enquanto posição aberta — padrão canónico Pine Script
if strategy.position_size > 0 and not na(activeLongTP)
    strategy.exit("Long Exit", from_entry="Long",
                   limit=activeLongTP, stop=activeLongSL,
                   comment_profit="TP ✓", comment_loss="SL ✗")

if strategy.position_size < 0 and not na(activeShortTP)
    strategy.exit("Short Exit", from_entry="Short",
                   limit=activeShortTP, stop=activeShortSL,
                   comment_profit="TP ✓", comment_loss="SL ✗")

// Limpar níveis guardados quando não há posição aberta
if strategy.position_size == 0
    activeLongTP  := na
    activeLongSL  := na
    activeShortTP := na
    activeShortSL := na

// ── Labels de Entry / TP / SL no gráfico (opcional) ───────────────────────
if validLong and i_showLabels
    label.new(bar_index, low - (high - low) * 0.5,
              text  = "L " + sessionLabel + "\nE "  + str.tostring(longEntry, "#.##")
                           + "\nTP " + str.tostring(longTP, "#.##")
                           + "\nSL " + str.tostring(longSL, "#.##")
                           + "\nR "  + str.tostring(longRisk, "#.##") + " pts",
              style = label.style_label_up,
              color = color.new(color.green, 20),
              textcolor = color.white,
              size  = size.small)

if validShort and i_showLabels
    label.new(bar_index, high + (high - low) * 0.5,
              text  = "S " + sessionLabel + "\nE "  + str.tostring(shortEntry, "#.##")
                           + "\nTP " + str.tostring(shortTP, "#.##")
                           + "\nSL " + str.tostring(shortSL, "#.##")
                           + "\nR "  + str.tostring(shortRisk, "#.##") + " pts",
              style = label.style_label_down,
              color = color.new(color.red, 20),
              textcolor = color.white,
              size  = size.small)

// ── Plots de diagnóstico ───────────────────────────────────────────────────
plotshape(validLong,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal)
plotshape(validShort, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.normal)
plotshape(bullBreakNow, title="Bull OB Break", style=shape.labelup,   location=location.belowbar, color=color.new(color.lime,  30), size=size.tiny, text="OB✓")
plotshape(bearBreakNow, title="Bear OB Break", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange,30), size=size.tiny, text="OB✓")

plotchar(inSession,         "In Session", "S", location.top,      color.yellow, size=size.tiny)
plotchar(bullFVG_active,    "Bull FVG",   "F", location.abovebar, color.green,  size=size.tiny)
plotchar(bearFVG_active,    "Bear FVG",   "F", location.belowbar, color.red,    size=size.tiny)
plotchar(bias == "BULLISH", "Bias Bull",  "B", location.abovebar, color.lime,   size=size.tiny)
plotchar(bias == "BEARISH", "Bias Bear",  "B", location.belowbar, color.orange, size=size.tiny)

// ── Tabela de referência MNQ (canto superior direito) ─────────────────────
var table infoTable = table.new(position.top_right, 2, 5,
                                 border_color=color.gray, border_width=1,
                                 bgcolor=color.new(color.black, 70))

// FIX warning barstate.islast: tabela populada na primeira barra (valores estáticos)
// Não usar barstate.islast em strategies sem calc_on_every_tick
if barstate.isfirst
    table.cell(infoTable, 0, 0, "MNQ Backtest",    text_color=color.white,  text_size=size.small, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 1, 0, "Parâmetros",       text_color=color.white,  text_size=size.small, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 0, 1, "Tick",             text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 1, "0.25 pts = $0.50", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 0, 2, "Ponto",            text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 2, "1 pt = $2.00",     text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 0, 3, "Contratos",        text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(i_contracts),  text_color=color.yellow, text_size=size.tiny)
    table.cell(infoTable, 0, 4, "Comissão/lado",    text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 4, "$" + str.tostring(i_commission, "#.##"), text_color=color.yellow, text_size=size.tiny)
