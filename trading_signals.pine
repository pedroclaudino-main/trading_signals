//@version=6
indicator("Trading Signals", overlay=true, max_bars_back=500, max_labels_count=200)

// ── Inputs ─────────────────────────────────────────────────────────────────
var string WEBHOOK_URL    = input.string("https://trading-signals.up.railway.app/webhook", "Webhook URL")
var string WEBHOOK_SECRET = input.string("", "Webhook Secret (autenticação)")

swingLookback = input.int(5,     "Swing Lookback (bars)",           minval=2,   maxval=20)
obStrength    = input.float(1.5, "OB Break Strength (multiplier)",  minval=1.0, maxval=3.0)
maxRiskPts    = input.float(60.0,"Max Risk (points)",               minval=10.0)

// ── Session windows (Europe/Lisbon — handles summer/winter auto) ───────────
inSession1 = not na(time(timeframe.period, "1445-1515:1234567", "Europe/Lisbon"))
inSession2 = not na(time(timeframe.period, "1545-1615:1234567", "Europe/Lisbon"))
inSession3 = not na(time(timeframe.period, "1645-1715:1234567", "Europe/Lisbon"))
inSession  = inSession1 or inSession2 or inSession3

// FIX #11: session label só é definido dentro de uma sessão ativa
sessionLabel = inSession1 ? "14:45" : inSession2 ? "15:45" : inSession3 ? "16:45" : "N/A"

bgcolor(inSession ? color.new(color.blue, 92) : na, title="Session Window")

// ── FIX #8: Arredondamento ao tick de 0.25 (tamanho mínimo do MNQ) ─────────
roundTick(x) => math.round(x * 4) / 4

// ── Order Block Detection ──────────────────────────────────────────────────
isBullishOB(i) => close[i] < open[i] and close[i-1] > open[i-1] and (close[i-1] - open[i-1]) > (high[i] - low[i]) * obStrength
isBearishOB(i) => close[i] > open[i] and close[i-1] < open[i-1] and (open[i-1] - close[i-1]) > (high[i] - low[i]) * obStrength

var float  bullOB_high   = na
var float  bullOB_low    = na
var float  bearOB_high   = na
var float  bearOB_low    = na
var bool   bullOB_broken = false
var bool   bearOB_broken = false
var string bias          = "NONE"

if isBullishOB(1)
    bullOB_high   := high[1]
    bullOB_low    := low[1]
    bullOB_broken := false

if isBearishOB(1)
    bearOB_high   := high[1]
    bearOB_low    := low[1]
    bearOB_broken := false

bullBreakNow = not bullOB_broken and not na(bullOB_high) and close > bullOB_high
bearBreakNow = not bearOB_broken and not na(bearOB_low)  and close < bearOB_low

if bullBreakNow
    bullOB_broken := true
    bias          := "BULLISH"

if bearBreakNow
    bearOB_broken := true
    bias          := "BEARISH"

// FIX #9: Bias reseta no FIM de cada sessão (não no início)
// Reset no início causava race condition: OB break na 1ª barra era imediatamente apagado
sessionEnded = not inSession and inSession[1]
if sessionEnded
    bias := "NONE"

// ── FIX #2 + #3 + #6: FVG persistidos com var, bearFVG top/bottom corrigidos ─
// Bullish FVG: gap up → low[0] > high[2]
//   top    = low[0]  (preço mais alto — limite superior do gap)
//   bottom = high[2] (preço mais baixo — limite inferior do gap)
//
// Bearish FVG: gap down → high[0] < low[2]
//   FIX #3: top    = low[2]  (preço mais alto — limite superior do gap)  ← era high[0] ERRADO
//   FIX #3: bottom = high[0] (preço mais baixo — limite inferior do gap) ← era low[2]  ERRADO

var float bullFVG_top    = na
var float bullFVG_bottom = na
var int   bullFVG_bar    = na
var bool  bullFVG_active = false

var float bearFVG_top    = na
var float bearFVG_bottom = na
var int   bearFVG_bar    = na
var bool  bearFVG_active = false

// FIX #7: guardar referência das boxes para eliminar as antigas
var box lastBullBox = na
var box lastBearBox = na

newBullFVG = low[0] > high[2]
newBearFVG = high[0] < low[2]

if newBullFVG
    bullFVG_top    := low[0]
    bullFVG_bottom := high[2]
    bullFVG_bar    := bar_index
    bullFVG_active := true
    box.delete(lastBullBox)
    lastBullBox    := box.new(bar_index - 2, bullFVG_top, bar_index + 20, bullFVG_bottom,
                               border_color = color.new(color.green, 50),
                               bgcolor      = color.new(color.green, 88))

if newBearFVG
    bearFVG_top    := low[2]   // FIX #3: preço mais alto (limite superior)
    bearFVG_bottom := high[0]  // FIX #3: preço mais baixo (limite inferior)
    bearFVG_bar    := bar_index
    bearFVG_active := true
    box.delete(lastBearBox)
    lastBearBox    := box.new(bar_index - 2, bearFVG_top, bar_index + 20, bearFVG_bottom,
                               border_color = color.new(color.red, 50),
                               bgcolor      = color.new(color.red, 88))

// FIX #4: FVG expira após 20 barras sem toque
if bullFVG_active and (bar_index - bullFVG_bar) > 20
    bullFVG_active := false
    box.delete(lastBullBox)

if bearFVG_active and (bar_index - bearFVG_bar) > 20
    bearFVG_active := false
    box.delete(lastBearBox)

// ── Swing Points for SL ────────────────────────────────────────────────────
swingHigh = ta.pivothigh(high, swingLookback, swingLookback)
swingLow  = ta.pivotlow(low,  swingLookback, swingLookback)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow  := swingLow

// Swing points desenhados com plot (fixos no preço, sem flutuação)
plot(swingHigh, title="Swing High", style=plot.style_cross,   color=color.new(color.red,   40), linewidth=2, offset=-swingLookback)
plot(swingLow,  title="Swing Low",  style=plot.style_cross,   color=color.new(color.green, 40), linewidth=2, offset=-swingLookback)

// ── FIX #2: Toque no FVG numa barra FUTURA (não na mesma barra de deteção) ─
// A guarda "not newBullFVG" / "not newBearFVG" impede o toque na barra de criação.
// FIX #3: bearFVG_bottom/top agora têm os preços corretos → condição possível.
touchesBullFVG = bias == "BULLISH" and bullFVG_active and not newBullFVG
               and low <= bullFVG_top and low >= bullFVG_bottom

touchesBearFVG = bias == "BEARISH" and bearFVG_active and not newBearFVG
               and high >= bearFVG_bottom and high <= bearFVG_top

// Invalidar FVG após toque para evitar entradas múltiplas no mesmo FVG
if touchesBullFVG
    bullFVG_active := false

if touchesBearFVG
    bearFVG_active := false

longSignal  = inSession and touchesBullFVG and not na(lastSwingLow)
shortSignal = inSession and touchesBearFVG and not na(lastSwingHigh)

// FIX: proteger contra sinal duplo simultâneo — se ambos ativos, nenhum dispara
if longSignal and shortSignal
    longSignal  := false
    shortSignal := false

// ── FIX #1 + #8: Entry = limite do FVG, TP/SL arredondados ao tick de 0.25 ─
longEntry = longSignal  ? roundTick(bullFVG_bottom) : na   // FIX #1: bottom do FVG bullish
longSL    = longSignal  ? roundTick(lastSwingLow)   : na
longTP    = longSignal  ? roundTick(bullFVG_bottom + (bullFVG_bottom - lastSwingLow) * 2.0) : na
longRisk  = longSignal  ? bullFVG_bottom - lastSwingLow : na

shortEntry = shortSignal ? roundTick(bearFVG_top)    : na  // FIX #1: top do FVG bearish
shortSL    = shortSignal ? roundTick(lastSwingHigh)  : na
shortTP    = shortSignal ? roundTick(bearFVG_top - (lastSwingHigh - bearFVG_top) * 2.0) : na
shortRisk  = shortSignal ? lastSwingHigh - bearFVG_top : na

validLong  = longSignal  and not na(longRisk)  and longRisk  > 0 and longRisk  <= maxRiskPts
validShort = shortSignal and not na(shortRisk) and shortRisk > 0 and shortRisk <= maxRiskPts

// ── Marcadores fixos no preço (plot) + labels com texto (sinais raros) ─────

// Swing points — plot (fixo, aparece em muitas barras)
// já desenhados acima com plot()

// Entry/TP/SL — plot (fixos no preço)
plot(validLong  ? longEntry  : na, title="Long Entry",  style=plot.style_circles, color=color.green,                 linewidth=4)
plot(validLong  ? longTP     : na, title="Long TP",     style=plot.style_cross,   color=color.new(color.green, 40),  linewidth=2)
plot(validLong  ? longSL     : na, title="Long SL",     style=plot.style_cross,   color=color.new(color.red, 40),    linewidth=2)
plot(validShort ? shortEntry : na, title="Short Entry", style=plot.style_circles, color=color.red,                   linewidth=4)
plot(validShort ? shortTP    : na, title="Short TP",    style=plot.style_cross,   color=color.new(color.red, 40),    linewidth=2)
plot(validShort ? shortSL    : na, title="Short SL",    style=plot.style_cross,   color=color.new(color.green, 40),  linewidth=2)

// OB breaks — plot (fixos no preço)
plot(bullBreakNow ? bullOB_high : na, title="Bull OB Break", style=plot.style_circles, color=color.lime,   linewidth=3)
plot(bearBreakNow ? bearOB_low  : na, title="Bear OB Break", style=plot.style_circles, color=color.orange, linewidth=3)

bgcolor(validLong ? color.new(color.green, 85) : validShort ? color.new(color.red, 85) : na, title="Signal Bar")

// Labels de texto — apenas nos sinais (raros, não poluem)
if validLong
    label.new(bar_index, longEntry, text="▲ LONG\nE " + str.tostring(longEntry, "#.##") + "\nTP " + str.tostring(longTP, "#.##") + "\nSL " + str.tostring(longSL, "#.##"),
              style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
if validShort
    label.new(bar_index, shortEntry, text="▼ SHORT\nE " + str.tostring(shortEntry, "#.##") + "\nTP " + str.tostring(shortTP, "#.##") + "\nSL " + str.tostring(shortSL, "#.##"),
              style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
if bullBreakNow
    label.new(bar_index, bullOB_high, text="OB✓", style=label.style_label_up, color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
if bearBreakNow
    label.new(bar_index, bearOB_low, text="OB✓", style=label.style_label_down, color=color.new(color.orange, 30), textcolor=color.white, size=size.tiny)

// ── Legenda fixa (canto superior direito) ──────────────────────────────────
var table legend = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_color=color.new(color.gray, 60), border_width=1)
if barstate.islastconfirmedhistory or barstate.islast
    table.cell(legend, 0, 0, "LEGENDA",          text_color=color.white,  text_size=size.small, text_halign=text.align_left)
    table.cell(legend, 1, 0, "",                  text_color=color.white,  text_size=size.small)
    table.cell(legend, 0, 1, "● Verde",           text_color=color.green,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 1, "Long Entry",        text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 2, "● Vermelho",        text_color=color.red,    text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 2, "Short Entry",       text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 3, "✕ Verde/Verm",      text_color=color.green,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 3, "TP / SL",           text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 4, "✕ Verm/Verde",      text_color=color.red,    text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 4, "Swing High / Low",  text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 5, "● Lima",            text_color=color.lime,   text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 5, "Bull OB Break",     text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 6, "● Laranja",         text_color=color.orange, text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 6, "Bear OB Break",     text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 7, "█ Azul",            text_color=color.blue,   text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 7, "Sessão ativa",      text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)

// ── Diagnóstico (visível apenas no Data Window) ───────────────────────────
plotchar(inSession,          "In Session", char="", location=location.top,      color=color.yellow, display=display.data_window)
plotchar(bullFVG_active,     "Bull FVG",   char="", location=location.abovebar, color=color.green,  display=display.data_window)
plotchar(bearFVG_active,     "Bear FVG",   char="", location=location.belowbar, color=color.red,    display=display.data_window)
plotchar(bias == "BULLISH",  "Bias Bull",  char="", location=location.abovebar, color=color.lime,   display=display.data_window)
plotchar(bias == "BEARISH",  "Bias Bear",  char="", location=location.belowbar, color=color.orange, display=display.data_window)

// ── FIX #5 + #10: Webhook payload com campos corretos e proteção contra na ─
if (validLong or validShort) and barstate.isconfirmed
    entryPrice = validLong ? longEntry  : shortEntry
    slPrice    = validLong ? longSL     : shortSL
    tpPrice    = validLong ? longTP     : shortTP
    riskPts    = validLong ? longRisk   : shortRisk
    obHigh     = validLong ? bullOB_high : bearOB_high
    obLow      = validLong ? bullOB_low  : bearOB_low
    fvgTop     = validLong ? bullFVG_top    : bearFVG_top
    fvgBottom  = validLong ? bullFVG_bottom : bearFVG_bottom
    fvgType    = validLong ? "bullish"  : "bearish"
    obType     = validLong ? "bullish"  : "bearish"

    // FIX #10: proteger swing points contra na → "null" em vez de NaN no JSON
    swingLowStr  = not na(lastSwingLow)  ? str.tostring(lastSwingLow,  "#.##") : "null"
    swingHighStr = not na(lastSwingHigh) ? str.tostring(lastSwingHigh, "#.##") : "null"

    payload  = '{"webhook_secret":"' + WEBHOOK_SECRET + '",'
    payload += '"session":"'       + sessionLabel + '",'
    payload += '"current_price":'  + str.tostring(close, "#.##") + ','
    // FIX #5: campo renomeado de "candles" para "candles_1m"
    payload += '"candles_1m":['
    payload += '{"o":' + str.tostring(open,    "#.##") + ',"h":' + str.tostring(high,    "#.##") + ',"l":' + str.tostring(low,    "#.##") + ',"c":' + str.tostring(close,    "#.##") + '},'
    payload += '{"o":' + str.tostring(open[1], "#.##") + ',"h":' + str.tostring(high[1], "#.##") + ',"l":' + str.tostring(low[1], "#.##") + ',"c":' + str.tostring(close[1], "#.##") + '},'
    payload += '{"o":' + str.tostring(open[2], "#.##") + ',"h":' + str.tostring(high[2], "#.##") + ',"l":' + str.tostring(low[2], "#.##") + ',"c":' + str.tostring(close[2], "#.##") + '}],'
    payload += '"broken_ob":{"type":"' + obType + '","high":' + str.tostring(obHigh, "#.##") + ',"low":' + str.tostring(obLow, "#.##") + '},'
    payload += '"fvgs":[{"type":"' + fvgType + '","top":' + str.tostring(fvgTop, "#.##") + ',"bottom":' + str.tostring(fvgBottom, "#.##") + ',"after_ob_break":true}],'
    // FIX #5: campo renomeado de "swing_points" para "swings"
    payload += '"swings":[{"type":"low","price":' + swingLowStr + '},{"type":"high","price":' + swingHighStr + '}],'
    // FIX #5: estrutura simplificada para "suggested_entry" e "suggested_sl" (era "pre_calculated")
    payload += '"suggested_entry":' + str.tostring(entryPrice, "#.##") + ','
    payload += '"suggested_sl":'    + str.tostring(slPrice,    "#.##") + ','
    payload += '"tp":'              + str.tostring(tpPrice,    "#.##") + ','
    payload += '"risk_pts":'        + str.tostring(riskPts,    "#.##") + '}'

    alert(payload, alert.freq_once_per_bar_close)

