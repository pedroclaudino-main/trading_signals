//@version=6
indicator("Trading Signals v2", overlay=true, max_bars_back=500, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════
var string WEBHOOK_URL    = input.string("https://trading-signals.up.railway.app/webhook", "Webhook URL")
var string WEBHOOK_SECRET = input.string("", "Webhook Secret")

swingLookback = input.int  (5,    "Swing Lookback",           minval=2,   maxval=20,  group="Estratégia")
obStrength    = input.float(1.5,  "OB Strength (multiplier)", minval=1.0, maxval=3.0, group="Estratégia")
maxRiskPts    = input.float(60.0, "Max Risk (pontos)",         minval=10.0,            group="Estratégia")

atrLen        = input.int  (14,   "ATR Period",                minval=5,   maxval=50,  group="Filtros")
minFvgMult    = input.float(0.05, "FVG Min Size (× ATR)",      minval=0.01,maxval=1.0, group="Filtros")
useDispFilter = input.bool (true, "Filtro: Deslocamento OB",                           group="Filtros")
useFvgReject  = input.bool (true, "Filtro: Rejeição no FVG",                           group="Filtros")
useHTFFilter  = input.bool (false,"Filtro: HTF 5m EMA50",                              group="Filtros")

// ═══════════════════════════════════════════════════════════════════════════
// SESSIONS
// ═══════════════════════════════════════════════════════════════════════════
inSession1 = not na(time(timeframe.period, "1445-1515:1234567", "Europe/Lisbon"))
inSession2 = not na(time(timeframe.period, "1545-1615:1234567", "Europe/Lisbon"))
inSession3 = not na(time(timeframe.period, "1645-1715:1234567", "Europe/Lisbon"))
inSession   = inSession1 or inSession2 or inSession3
sessionLabel = inSession1 ? "14:45" : inSession2 ? "15:45" : inSession3 ? "16:45" : "N/A"

bgcolor(inSession ? color.new(color.blue, 92) : na, title="Session Window")

// ═══════════════════════════════════════════════════════════════════════════
// UTILITIES
// ═══════════════════════════════════════════════════════════════════════════
roundTick(x) => math.round(x * 4) / 4

atr = ta.atr(atrLen)

// Deslocamento institucional: range >= 0.8×ATR e corpo >= 60% do range
isDisplacement(offset) =>
    r = high[offset] - low[offset]
    b = math.abs(close[offset] - open[offset])
    r >= atr * 0.8 and b >= r * 0.6

// HTF bias: 5m EMA50 como filtro direcional (opcional)
htfEma    = useHTFFilter
    ? request.security(syminfo.tickerid, "5", ta.ema(close, 50), lookahead=barmerge.lookahead_off)
    : na
htfBullOK = not useHTFFilter or (not na(htfEma) and close > htfEma)
htfBearOK = not useHTFFilter or (not na(htfEma) and close < htfEma)

// ═══════════════════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION
// Bullish OB: vela bearish[1] + vela bullish[0] com momentum + displacement (opcional)
// isBullishOB(1): bar[1]=OB bearish, bar[0]=displacement bullish
// ═══════════════════════════════════════════════════════════════════════════
isBullishOB(i) =>
    bearish     = close[i]   < open[i]
    bullishNext = close[i-1] > open[i-1]
    momentum    = (close[i-1] - open[i-1]) > (high[i] - low[i]) * obStrength
    hasDisp     = useDispFilter ? isDisplacement(i-1) : true
    bearish and bullishNext and momentum and hasDisp

isBearishOB(i) =>
    bullish     = close[i]   > open[i]
    bearishNext = close[i-1] < open[i-1]
    momentum    = (open[i-1] - close[i-1]) > (high[i] - low[i]) * obStrength
    hasDisp     = useDispFilter ? isDisplacement(i-1) : true
    bullish and bearishNext and momentum and hasDisp

var float  bullOB_high   = na
var float  bullOB_low    = na
var float  bearOB_high   = na
var float  bearOB_low    = na
var bool   bullOB_broken = false
var bool   bearOB_broken = false
var string bias          = "NONE"
var int    biasBar       = -999  // bar_index quando o bias foi definido

if isBullishOB(1)
    bullOB_high   := high[1]
    bullOB_low    := low[1]
    bullOB_broken := false

if isBearishOB(1)
    bearOB_high   := high[1]
    bearOB_low    := low[1]
    bearOB_broken := false

bullBreakNow = not bullOB_broken and not na(bullOB_high) and close > bullOB_high
bearBreakNow = not bearOB_broken and not na(bearOB_low)  and close < bearOB_low

if bullBreakNow
    bullOB_broken := true
    bias          := "BULLISH"
    biasBar       := bar_index

if bearBreakNow
    bearOB_broken := true
    bias          := "BEARISH"
    biasBar       := bar_index

// Bias reseta no FIM de cada sessão
sessionEnded = not inSession and inSession[1]
if sessionEnded
    bias    := "NONE"
    biasBar := -999

// ═══════════════════════════════════════════════════════════════════════════
// FVG DETECTION (com filtro de tamanho mínimo × ATR)
// ═══════════════════════════════════════════════════════════════════════════
fvgMinSize = atr * minFvgMult

var float bullFVG_top    = na
var float bullFVG_bottom = na
var int   bullFVG_bar    = na
var bool  bullFVG_active = false

var float bearFVG_top    = na
var float bearFVG_bottom = na
var int   bearFVG_bar    = na
var bool  bearFVG_active = false

var box lastBullBox = na
var box lastBearBox = na

// Filtro de tamanho integrado na deteção
newBullFVG = low[0] > high[2] and (low[0] - high[2]) >= fvgMinSize
newBearFVG = high[0] < low[2] and (low[2] - high[0]) >= fvgMinSize

if newBullFVG
    bullFVG_top    := low[0]
    bullFVG_bottom := high[2]
    bullFVG_bar    := bar_index
    bullFVG_active := true
    box.delete(lastBullBox)
    lastBullBox    := box.new(bar_index - 2, bullFVG_top, bar_index + 20, bullFVG_bottom,
                               border_color=color.new(color.green, 50),
                               bgcolor     =color.new(color.green, 88))

if newBearFVG
    bearFVG_top    := low[2]
    bearFVG_bottom := high[0]
    bearFVG_bar    := bar_index
    bearFVG_active := true
    box.delete(lastBearBox)
    lastBearBox    := box.new(bar_index - 2, bearFVG_top, bar_index + 20, bearFVG_bottom,
                               border_color=color.new(color.red, 50),
                               bgcolor     =color.new(color.red, 88))

// FVG expira após 20 barras
if bullFVG_active and (bar_index - bullFVG_bar) > 20
    bullFVG_active := false
    box.delete(lastBullBox)

if bearFVG_active and (bar_index - bearFVG_bar) > 20
    bearFVG_active := false
    box.delete(lastBearBox)

// ═══════════════════════════════════════════════════════════════════════════
// SWING POINTS
// ═══════════════════════════════════════════════════════════════════════════
swingHigh = ta.pivothigh(high, swingLookback, swingLookback)
swingLow  = ta.pivotlow (low,  swingLookback, swingLookback)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow  := swingLow

plot(swingHigh, "Swing High", color.new(color.red,   40), 2, plot.style_cross, offset=-swingLookback)
plot(swingLow,  "Swing Low",  color.new(color.green, 40), 2, plot.style_cross, offset=-swingLookback)

// ═══════════════════════════════════════════════════════════════════════════
// FVG TOUCH — com todos os filtros
//
// NOVO [C1+C2]: FVG deve ter sido formado APÓS o bias ser definido.
//   bullFVG_bar > biasBar garante que o FVG é resultado do mesmo movimento
//   que quebrou o OB — não um FVG anterior ao break.
//
// NOVO [C1]: bar_index > biasBar impede entrada na mesma barra do OB break.
//
// NOVO [C5]: bullReject / bearReject — vela fecha na direção do bias após
//   tocar o FVG (confirmação de rejeição institucional).
// ═══════════════════════════════════════════════════════════════════════════
bullFvgPostBias = not na(bullFVG_bar) and bullFVG_bar > biasBar
bearFvgPostBias = not na(bearFVG_bar) and bearFVG_bar > biasBar

biasDelay = bar_index > biasBar  // mínimo 1 barra após OB break

touchesBullFVG = bias == "BULLISH"
               and bullFVG_active
               and not newBullFVG
               and bullFvgPostBias
               and biasDelay
               and low  <= bullFVG_top
               and low  >= bullFVG_bottom
               and htfBullOK

touchesBearFVG = bias == "BEARISH"
               and bearFVG_active
               and not newBearFVG
               and bearFvgPostBias
               and biasDelay
               and high >= bearFVG_bottom
               and high <= bearFVG_top
               and htfBearOK

// Rejeição: vela fecha na direção do bias após tocar o FVG
bullReject = not useFvgReject or close > open
bearReject = not useFvgReject or close < open

// Invalidar FVG após toque (1 sinal por FVG)
if touchesBullFVG
    bullFVG_active := false
if touchesBearFVG
    bearFVG_active := false

longSignal  = inSession and touchesBullFVG and bullReject and not na(lastSwingLow)
shortSignal = inSession and touchesBearFVG and bearReject and not na(lastSwingHigh)

// Proteger contra sinal duplo simultâneo
if longSignal and shortSignal
    longSignal  := false
    shortSignal := false

// ═══════════════════════════════════════════════════════════════════════════
// ENTRY / SL / TP (R:R 1:2 fixo)
// ═══════════════════════════════════════════════════════════════════════════
longEntry = longSignal  ? roundTick(bullFVG_bottom) : na
longSL    = longSignal  ? roundTick(lastSwingLow)   : na
longTP    = longSignal  ? roundTick(bullFVG_bottom + (bullFVG_bottom - lastSwingLow) * 2.0) : na
longRisk  = longSignal  ? bullFVG_bottom - lastSwingLow : na

shortEntry = shortSignal ? roundTick(bearFVG_top)   : na
shortSL    = shortSignal ? roundTick(lastSwingHigh)  : na
shortTP    = shortSignal ? roundTick(bearFVG_top - (lastSwingHigh - bearFVG_top) * 2.0) : na
shortRisk  = shortSignal ? lastSwingHigh - bearFVG_top : na

validLong  = longSignal  and not na(longRisk)  and longRisk  > 0 and longRisk  <= maxRiskPts
validShort = shortSignal and not na(shortRisk) and shortRisk > 0 and shortRisk <= maxRiskPts

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════
plot(validLong  ? longEntry  : na, "Long Entry",  color.green,                linewidth=4, style=plot.style_circles)
plot(validLong  ? longTP     : na, "Long TP",     color.new(color.green, 40), linewidth=2, style=plot.style_cross)
plot(validLong  ? longSL     : na, "Long SL",     color.new(color.red,   40), linewidth=2, style=plot.style_cross)
plot(validShort ? shortEntry : na, "Short Entry", color.red,                  linewidth=4, style=plot.style_circles)
plot(validShort ? shortTP    : na, "Short TP",    color.new(color.red,   40), linewidth=2, style=plot.style_cross)
plot(validShort ? shortSL    : na, "Short SL",    color.new(color.green, 40), linewidth=2, style=plot.style_cross)
plot(bullBreakNow ? bullOB_high : na, "Bull OB Break", color.lime,   linewidth=3, style=plot.style_circles)
plot(bearBreakNow ? bearOB_low  : na, "Bear OB Break", color.orange, linewidth=3, style=plot.style_circles)

bgcolor(validLong ? color.new(color.green, 85) : validShort ? color.new(color.red, 85) : na, title="Signal Bar")

if validLong
    label.new(bar_index, longEntry,
              text ="▲ LONG\nE "  + str.tostring(longEntry,  "#.##") +
                    "\nTP " + str.tostring(longTP,  "#.##") +
                    "\nSL " + str.tostring(longSL,  "#.##"),
              style=label.style_label_up, color=color.new(color.green, 20),
              textcolor=color.white, size=size.small)
if validShort
    label.new(bar_index, shortEntry,
              text ="▼ SHORT\nE " + str.tostring(shortEntry, "#.##") +
                    "\nTP " + str.tostring(shortTP, "#.##") +
                    "\nSL " + str.tostring(shortSL, "#.##"),
              style=label.style_label_down, color=color.new(color.red, 20),
              textcolor=color.white, size=size.small)
if bullBreakNow
    label.new(bar_index, bullOB_high, text="OB✓",
              style=label.style_label_up,   color=color.new(color.lime,   30),
              textcolor=color.white, size=size.tiny)
if bearBreakNow
    label.new(bar_index, bearOB_low,  text="OB✓",
              style=label.style_label_down, color=color.new(color.orange, 30),
              textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// LEGENDA (com filtros ativos)
// ═══════════════════════════════════════════════════════════════════════════
var table legend = table.new(position.top_right, 2, 10,
                              bgcolor      =color.new(color.black, 80),
                              border_color =color.new(color.gray,  60),
                              border_width =1)
if barstate.islastconfirmedhistory or barstate.islast
    table.cell(legend, 0, 0, "LEGENDA",          text_color=color.white,  text_size=size.small, text_halign=text.align_left)
    table.cell(legend, 1, 0, "",                  text_size=size.small)
    table.cell(legend, 0, 1, "● Verde",           text_color=color.green,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 1, "Long Entry",        text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 2, "● Vermelho",        text_color=color.red,    text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 2, "Short Entry",       text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 3, "✕ G/V",             text_color=color.green,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 3, "TP / SL",           text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 4, "● Lima",            text_color=color.lime,   text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 4, "Bull OB Break",     text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 5, "● Laranja",         text_color=color.orange, text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 5, "Bear OB Break",     text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 6, "█ Azul",            text_color=color.blue,   text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 6, "Sessão ativa",      text_color=color.white,  text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 7, "───────",           text_color=color.gray,   text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 1, 7, "───────",           text_color=color.gray,   text_size=size.tiny)
    table.cell(legend, 0, 8, "Filtros:",          text_color=color.gray,   text_size=size.tiny,  text_halign=text.align_left)
    _f = (useDispFilter ? "DISP " : "") + (useFvgReject ? "REJ " : "") + (useHTFFilter ? "HTF" : "")
    table.cell(legend, 1, 8, _f != "" ? _f : "—", text_color=color.yellow, text_size=size.tiny,  text_halign=text.align_left)
    table.cell(legend, 0, 9, "Bias:",             text_color=color.gray,   text_size=size.tiny,  text_halign=text.align_left)
    _biasColor = bias == "BULLISH" ? color.lime : bias == "BEARISH" ? color.orange : color.gray
    table.cell(legend, 1, 9, bias,                text_color=_biasColor,   text_size=size.tiny,  text_halign=text.align_left)

// ═══════════════════════════════════════════════════════════════════════════
// DATA WINDOW
// ═══════════════════════════════════════════════════════════════════════════
plotchar(inSession,          "In Session", "", location.top,      color.yellow, display=display.data_window)
plotchar(bullFVG_active,     "Bull FVG",   "", location.abovebar, color.green,  display=display.data_window)
plotchar(bearFVG_active,     "Bear FVG",   "", location.belowbar, color.red,    display=display.data_window)
plotchar(bias == "BULLISH",  "Bias Bull",  "", location.abovebar, color.lime,   display=display.data_window)
plotchar(bias == "BEARISH",  "Bias Bear",  "", location.belowbar, color.orange, display=display.data_window)

// ═══════════════════════════════════════════════════════════════════════════
// WEBHOOK PAYLOAD
// ═══════════════════════════════════════════════════════════════════════════
if (validLong or validShort) and barstate.isconfirmed
    entryPrice = validLong ? longEntry   : shortEntry
    slPrice    = validLong ? longSL      : shortSL
    tpPrice    = validLong ? longTP      : shortTP
    riskPts    = validLong ? longRisk    : shortRisk
    obHigh     = validLong ? bullOB_high : bearOB_high
    obLow      = validLong ? bullOB_low  : bearOB_low
    fvgTop     = validLong ? bullFVG_top    : bearFVG_top
    fvgBottom  = validLong ? bullFVG_bottom : bearFVG_bottom
    fvgType    = validLong ? "bullish"   : "bearish"
    obType     = validLong ? "bullish"   : "bearish"

    swingLowStr  = not na(lastSwingLow)  ? str.tostring(lastSwingLow,  "#.##") : "null"
    swingHighStr = not na(lastSwingHigh) ? str.tostring(lastSwingHigh, "#.##") : "null"

    payload  = '{"webhook_secret":"' + WEBHOOK_SECRET + '",'
    payload += '"session":"'        + sessionLabel + '",'
    payload += '"current_price":'   + str.tostring(close, "#.##") + ','
    payload += '"candles_1m":['
    payload += '{"o":' + str.tostring(open,    "#.##") + ',"h":' + str.tostring(high,    "#.##") + ',"l":' + str.tostring(low,    "#.##") + ',"c":' + str.tostring(close,    "#.##") + '},'
    payload += '{"o":' + str.tostring(open[1], "#.##") + ',"h":' + str.tostring(high[1], "#.##") + ',"l":' + str.tostring(low[1], "#.##") + ',"c":' + str.tostring(close[1], "#.##") + '},'
    payload += '{"o":' + str.tostring(open[2], "#.##") + ',"h":' + str.tostring(high[2], "#.##") + ',"l":' + str.tostring(low[2], "#.##") + ',"c":' + str.tostring(close[2], "#.##") + '}],'
    payload += '"broken_ob":{"type":"' + obType + '","high":' + str.tostring(obHigh, "#.##") + ',"low":' + str.tostring(obLow, "#.##") + '},'
    payload += '"fvgs":[{"type":"' + fvgType + '","top":' + str.tostring(fvgTop, "#.##") + ',"bottom":' + str.tostring(fvgBottom, "#.##") + ',"after_ob_break":true}],'
    payload += '"swings":[{"type":"low","price":' + swingLowStr + '},{"type":"high","price":' + swingHighStr + '}],'
    payload += '"suggested_entry":' + str.tostring(entryPrice, "#.##") + ','
    payload += '"suggested_sl":'    + str.tostring(slPrice,    "#.##") + ','
    payload += '"tp":'              + str.tostring(tpPrice,    "#.##") + ','
    payload += '"risk_pts":'        + str.tostring(riskPts,    "#.##") + '}'

    alert(payload, alert.freq_once_per_bar_close)
